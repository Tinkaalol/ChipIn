# Токен бота от @BotFather (нужен только боту)
BOT_TOKEN=123456:replace-me
# PostgreSQL из docker-compose (docker compose up -d db). Для локальных экспериментов
# подойдёт и SQLite: sqlite+aiosqlite:///./bot.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subscriptions
# Telegram ID администраторов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=

# --- Сайт (backend) ---
# Имя бота без @: нужно виджету входа. Домен сайта привяжите у @BotFather командой /setdomain
BOT_USERNAME=
# Длинная случайная строка для подписи cookie (python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=
# Публичный адрес сайта, например https://example.com
PUBLIC_URL=
# Для локальной разработки по http поставьте false
COOKIE_SECURE=true
